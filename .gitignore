# Local Python and test state
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Disposable Firecrawl execution state and body-redacted local run outputs.
# Curated evidence belongs under evidence/; raw per-run output stays local.
results/
.firecrawl-request.json

# Editor and OS residue
.DS_Store
*~

# Semantic ignored generated homes. These directories are outputs, not
# repository truth.
.cache/
build/
# Root tool caches and package output are denied residue. Tools must route
# caches to build/runtime/tool-cache/<tool>/, provider work to
# build/runtime/work/<provider>/, machine evidence to build/evidence/ or
# build/ethos/, and local artifacts to build/artifacts/<kind>/.
.import_linter_cache/
.import-linter-cache/
.tox/
.nox/
.uv-cache/
dist/
# Root coverage and pytest residue may be ignored local cleanup debt, but
# tracked copies are still generated-artifact topology violations.
.coverage
.coverage.*
coverage.xml
junit.xml
