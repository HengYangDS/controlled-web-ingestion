{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Body-redacted evidence record",
  "type": "object",
  "required": ["schema"],
  "properties": { "schema": { "type": "string", "pattern": ".+" } },
  "x-forbidden-recursive-keys": [
    "body",
    "content",
    "html",
    "markdown",
    "raw_response",
    "credentials",
    "authorization",
    "cookie",
    "private_target"
  ]
}
