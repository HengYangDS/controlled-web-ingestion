      "mode": "browser",
      "max_pages": 1,
      "timeout_seconds": 45
    },
    {
      "id": "crawl-quotes",
      "url": "https://quotes.toscrape.com/",
      "purpose": "verify bounded public crawl routing and cleanup",
      "mode": "crawl",
      "max_pages": 10,
      "timeout_seconds": 60
    }
  ]
}
